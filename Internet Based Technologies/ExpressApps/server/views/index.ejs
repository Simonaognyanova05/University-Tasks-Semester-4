<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>


    <body>
        <%- include('./partials/nav.ejs') %>
            <div class="blog-content">
                <h2>All services</h2>

                <% if(services.length> 0 ) { %>
                    <% services.forEach(service=> { %>
                        <a href="/catalog/<%= service._id %>">
                            <h1>
                                <%= service.title %>
                            </h1>
                            <p>
                                <%= service.descritpion %>
                            </p>
                            <p>
                                <%= service.location %>
                            </p>
                            <p>
                                <%= service.price %>
                            </p>
                        </a>

                        <% }) %>
                            <% } else {%>

                                <p>No services yet</p>
                                <% } %>
                                    <%- include('./partials/footer.ejs') %>


    </body>

</html>