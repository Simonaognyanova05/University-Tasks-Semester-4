<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>


    <body>
        <%- include('./partials/nav.ejs') %>
            <div class="blog-content">
                <h2>All Blogs</h2>

                <% if(blogs.length> 0 ) { %>
                    <% blogs.forEach(blog=> { %>
                        <h1>
                            <%= blog.title %>
                        </h1>
                        <p>
                            <%= blog.snippet %>
                        </p>

                        <% }) %>
                            <% } else {%>

                                <p>No blogs yet</p>
                                <% } %>
                                    <%- include('./partials/footer.ejs') %>


    </body>

</html>